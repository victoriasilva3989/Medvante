# ─── Servidor ───────────────────────────────────
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ─── Banco de Dados (PostgreSQL) ───────────────
DATABASE_URL=postgresql://postgres:SUA_SENHA@localhost:5432/medvante
# Ou use vars individuais:
DB_HOST=localhost
DB_PORT=5432
DB_NAME=medvante
DB_USER=postgres
DB_PASSWORD=SUA_SENHA

# ─── JWT ────────────────────────────────────────
JWT_SECRET=change-me-to-a-random-64-char-string
JWT_EXPIRES_IN=8h

# ─── SEFAZ (NF-e) ──────────────────────────────
# Ambiente: 1 = Produção, 2 = Homologação
# A UF agora é obtida automaticamente de cada empresa no banco (campo empresas.uf)
SEFAZ_AMBIENTE=2
SEFAZ_CERT_PATH=./certs/homologacao.pfx
SEFAZ_CERT_PASSWORD=

# ─── Open Finance Brasil ───────────────────────
OF_CLIENT_ID=
OF_CLIENT_SECRET=
OF_CERT_PATH=./certs/oficial.pfx
OF_CERT_PASSWORD=
OF_REDIRECT_URI=http://localhost:3000/api/openfinance/callback

# ─── NFSe (Nota Fiscal de Serviços) ───────────
NFSE_INSCRICAO_MUNICIPAL=0000000

# ─── Certificado Digital ──────────────────────
CERT_STORAGE_PATH=./certs
CERT_MAX_SIZE_MB=10

# ─── Jobs ──────────────────────────────────────
START_JOBS=false
